---
export const prerender = true;
import NotFoundView from '~/components/views/NotFoundView.astro';
import { getLocaleFromUrl } from '~/i18n';

// One 404 serves every locale: derive the language from the requested URL
// (e.g. /fr/does-not-exist renders the French chrome).
const locale = getLocaleFromUrl(Astro.url);
---
<NotFoundView locale={locale} />
