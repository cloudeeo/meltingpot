---
export const prerender = true;
import { isHidden } from '~/lib/launch';
import { getCollection } from 'astro:content';
import PostView from '~/components/views/PostView.astro';
import { filterByLocale, contentSlug } from '~/lib/content';

export async function getStaticPaths() {
  if (isHidden('/news')) return [];
  const posts = filterByLocale(await getCollection('posts', ({ data }) => !data.draft), 'fr');
  return posts.map((post) => ({
    params: { slug: contentSlug(post.id) },
    props: { post },
  }));
}

const { post } = Astro.props;
---
<PostView post={post} locale="fr" />
