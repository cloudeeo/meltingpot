---
export const prerender = true;
import { isHidden } from '~/lib/launch';
import { getCollection } from 'astro:content';
import CaseStudyView from '~/components/views/CaseStudyView.astro';
import { filterByLocale, contentSlug } from '~/lib/content';

export async function getStaticPaths() {
  if (isHidden('/portfolio')) return [];
  const entries = filterByLocale(await getCollection('caseStudies', ({ data }) => !data.draft), 'fr');
  return entries.map((entry) => ({
    params: { slug: contentSlug(entry.id) },
    props: { entry },
  }));
}

const { entry } = Astro.props;
---
<CaseStudyView entry={entry} locale="fr" />
