---
export const prerender = true;
import { getEntry } from 'astro:content';
import LegalView from '~/components/views/LegalView.astro';
import { getDictionary } from '~/i18n';

const t = getDictionary('fr');
const doc = await getEntry('legal', 'fr/terms');
if (!doc) throw new Error('Missing legal/fr/terms.mdx');
---
<LegalView
  doc={doc}
  locale="fr"
  path="/terms"
  seoTitle={t.legal.termsSeoTitle}
  seoDescription={t.legal.termsSeoDescription}
/>
