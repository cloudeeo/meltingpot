---
import { getDictionary, localizePath, type Locale } from '~/i18n';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = getDictionary(locale);
const privacyHref = localizePath('/privacy', locale);
---
<aside
  class="cookie-banner"
  id="cookie-banner"
  data-storage-key="ef-consent-v2"
  role="region"
  aria-label={t.cookieBanner.title}
  hidden
>
  <div class="cookie-banner-inner">
    <div class="cookie-banner-text">
      <p class="cookie-banner-title">{t.cookieBanner.title}</p>
      <p class="cookie-banner-body">
        {t.cookieBanner.body}{' '}
        <a href={privacyHref}>{t.cookieBanner.moreInfo}</a>.
      </p>
    </div>
    <div class="cookie-banner-actions">
      <button type="button" class="btn btn-primary" data-cookie-accept>
        {t.cookieBanner.accept}
      </button>
      <button type="button" class="btn btn-ghost" data-cookie-reject>
        {t.cookieBanner.reject}
      </button>
      <button
        type="button"
        class="cookie-banner-close"
        aria-label={t.cookieBanner.closeAria}
        data-cookie-reject
      >×</button>
    </div>
  </div>
</aside>

<script>
  /* Consent controller — opt-in to analytics only.
   *
   * - Persists `{ analytics: boolean, ts }` under `ef-consent-v2`.
   * - Emits `cookie:consent` with `{ analytics }` on every choice so the
   *   GoogleAnalytics loader (and any future tag) can react via
   *   gtag('consent','update', …).
   * - "Close" (×) is treated as a reject — equivalent to declining.
   * - Bump the storage key when adding any new tag category that needs
   *   fresh consent. */
  (() => {
    const banner = document.getElementById('cookie-banner') as HTMLElement | null;
    if (!banner) return;
    const KEY = banner.dataset.storageKey ?? 'ef-consent-v2';

    interface ConsentState {
      analytics: boolean;
      ts: string;
    }

    const readState = (): ConsentState | null => {
      try {
        const raw = window.localStorage.getItem(KEY);
        if (!raw) return null;
        const parsed = JSON.parse(raw) as Partial<ConsentState>;
        if (typeof parsed?.analytics !== 'boolean') return null;
        return { analytics: parsed.analytics, ts: parsed.ts ?? '' };
      } catch {
        return null;
      }
    };

    const writeState = (analytics: boolean): void => {
      const state: ConsentState = { analytics, ts: new Date().toISOString() };
      try {
        window.localStorage.setItem(KEY, JSON.stringify(state));
      } catch {
        // localStorage may be unavailable; we still hide the banner.
      }
      document.dispatchEvent(
        new CustomEvent('cookie:consent', { detail: { analytics } }),
      );
    };

    const show = (): void => {
      banner.hidden = false;
      requestAnimationFrame(() =>
        requestAnimationFrame(() => banner.classList.add('is-visible')),
      );
    };

    const hide = (): void => {
      banner.classList.remove('is-visible');
      window.setTimeout(() => {
        banner.hidden = true;
      }, 220);
    };

    banner.querySelectorAll<HTMLElement>('[data-cookie-accept]').forEach((el) => {
      el.addEventListener('click', () => {
        writeState(true);
        hide();
      });
    });
    banner.querySelectorAll<HTMLElement>('[data-cookie-reject]').forEach((el) => {
      el.addEventListener('click', () => {
        writeState(false);
        hide();
      });
    });

    // Footer "Cookie preferences" link reopens the banner.
    document.addEventListener('cookie:open', show);
    document.querySelectorAll<HTMLElement>('[data-cookie-trigger]').forEach((el) => {
      el.addEventListener('click', (e) => {
        e.preventDefault();
        document.dispatchEvent(new CustomEvent('cookie:open'));
      });
    });

    // First visit — no stored choice yet, show the banner.
    if (readState() === null) show();
  })();
</script>
