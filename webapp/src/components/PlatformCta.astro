---
import { SITE } from '~/lib/site';
import { getDictionary, type Locale } from '~/i18n';

interface Props {
  locale: Locale;
  /** Visual variant. Defaults to a quiet band. */
  variant?: 'band' | 'soft';
}
const { locale, variant = 'band' } = Astro.props;
const t = getDictionary(locale).platform;
const sectionClass =
  variant === 'soft' ? 'section section-light platform-band' : 'section platform-band';
---
<section class={sectionClass} aria-labelledby="platform-cta-title">
  <div class="container platform-band-inner">
    <div class="platform-band-text">
      <p class="eyebrow">{t.eyebrow}</p>
      <h2 id="platform-cta-title">{t.title}</h2>
      <p>{t.body}</p>
    </div>
    <a
      class="btn btn-primary"
      href={SITE.platformUrl}
      target="_blank"
      rel="noopener"
    >{t.button}</a>
  </div>
</section>
