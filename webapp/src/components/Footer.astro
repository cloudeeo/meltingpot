---
import LogoMark from './LogoMark.astro';
import { SITE } from '~/lib/site';
import { getDictionary, getNav, getCta, type Locale } from '~/i18n';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = getDictionary(locale);
const nav = getNav(locale);
const cta = getCta(locale);
const year = new Date().getFullYear();
const socials = [
  { label: 'LinkedIn', href: SITE.social.linkedin },
  { label: 'YouTube', href: SITE.social.youtube },
  { label: 'X / Twitter', href: SITE.social.twitter },
].filter((s) => s.href);
---
<footer class="site-footer">
  <div class="container footer-grid">
    <div class="footer-brand">
      <LogoMark size={32} />
      <div class="footer-brand-text">
        <strong>{SITE.name}</strong>
        <p>{t.footer.blurb}</p>
      </div>
    </div>

    <div>
      <h2 class="footer-heading">{t.footer.explore}</h2>
      <ul class="footer-menu">
        {nav.map((item) => (
          <li><a href={item.href}>{item.label}</a></li>
        ))}
      </ul>
    </div>

    <div>
      <h2 class="footer-heading">{t.footer.contact}</h2>
      <ul class="footer-menu">
        <li><a href={cta.href}>{t.footer.getInTouch}</a></li>
      </ul>
      {socials.length > 0 && (
        <ul class="footer-social" aria-label={t.footer.socialLabel}>
          {socials.map((s) => (
            <li><a href={s.href} target="_blank" rel="me noopener">{s.label}</a></li>
          ))}
        </ul>
      )}
    </div>
  </div>

  <div class="container footer-base">
    <p>&copy; {year} {SITE.name}. {t.footer.rights}</p>
    <p class="footer-tag">{t.footer.tag}</p>
  </div>
</footer>
