---
import { Image } from 'astro:assets';
import { truncate } from '~/lib/format';
import { caseStudyHref } from '~/lib/content';
import { type Locale } from '~/i18n';
import type { CollectionEntry } from 'astro:content';

interface Props {
  entry: CollectionEntry<'caseStudies'>;
  locale: Locale;
}
const { entry, locale } = Astro.props;
const href = caseStudyHref(entry, locale);
---
<article class="card card-case">
  {entry.data.cover && (
    <a class="card-media" href={href} aria-label={entry.data.title} tabindex="-1">
      <Image src={entry.data.cover} alt="" width={800} height={500} loading="lazy" />
    </a>
  )}
  <div class="card-body">
    <p class="card-meta">
      {entry.data.sector && <span class="card-tag">{entry.data.sector}</span>}
      {entry.data.year && <span>{entry.data.year}</span>}
    </p>
    <h3 class="card-title"><a href={href}>{entry.data.title}</a></h3>
    {entry.data.client && <p class="card-client">{entry.data.client}</p>}
    <p class="card-excerpt">{truncate(entry.data.description, 180)}</p>
  </div>
</article>
