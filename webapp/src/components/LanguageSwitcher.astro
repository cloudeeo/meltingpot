---
import {
  getAlternates,
  getDictionary,
  localeHtmlLang,
  localeLabels,
  localeShortLabels,
  type Locale,
} from '~/i18n';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = getDictionary(locale);

// One link per locale, pointing at the equivalent path in that language.
const options = getAlternates(Astro.url.pathname);
---
<nav class="lang-switcher" aria-label={t.langSwitcher.aria}>
  <ul>
    {options.map((opt) => {
      const isCurrent = opt.locale === locale;
      return (
        <li>
          <a
            href={opt.path}
            hreflang={localeHtmlLang[opt.locale]}
            lang={localeHtmlLang[opt.locale]}
            class={isCurrent ? 'is-current' : ''}
            aria-current={isCurrent ? 'true' : undefined}
            aria-label={localeLabels[opt.locale]}
          >{localeShortLabels[opt.locale]}</a>
        </li>
      );
    })}
  </ul>
</nav>
