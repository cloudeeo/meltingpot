---
import Base from '~/layouts/Base.astro';
import CardVideo from '~/components/CardVideo.astro';
import { buildSeo } from '~/lib/seo';
import { getCollection } from 'astro:content';
import { filterByLocale } from '~/lib/content';
import { getDictionary, localizePath, type Locale } from '~/i18n';

interface Props {
  locale: Locale;
}
const { locale } = Astro.props;
const t = getDictionary(locale);
const d = t.digitalMedia;

const seo = buildSeo({
  path: localizePath('/digital-media', locale),
  locale,
  title: d.seoTitle,
  description: d.seoDescription,
});

const videos = filterByLocale(await getCollection('videos', ({ data }) => !data.draft), locale)
  .sort((a, b) => b.data.publishedAt.getTime() - a.data.publishedAt.getTime());
---
<Base seo={seo}>
  <section class="page-hero">
    <div class="container">
      <p class="eyebrow">{d.eyebrow}</p>
      <h1>{d.title}</h1>
      <p class="page-lede">{d.lede}</p>
    </div>
  </section>

  <section class="section">
    <div class="container">
      {videos.length > 0 ? (
        <ul class="video-grid">
          {videos.map((entry) => (
            <li><CardVideo entry={entry} /></li>
          ))}
        </ul>
      ) : (
        <div class="empty-state empty-state-callout">
          <h2>{d.emptyTitle}</h2>
          <p>{d.emptyBody}</p>
          <a class="btn btn-primary" href={localizePath('/contact', locale)}>{d.emptyButton}</a>
        </div>
      )}
    </div>
  </section>
</Base>
