---
import { render } from 'astro:content';
import type { CollectionEntry } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '~/layouts/Base.astro';
import LogoMark from '~/components/LogoMark.astro';
import PlatformCta from '~/components/PlatformCta.astro';
import { buildSeo } from '~/lib/seo';
import { contentSlug } from '~/lib/content';
import { getDictionary, localizePath, type Locale } from '~/i18n';

import strategicAdvisory from '~/assets/images/services/strategic-advisory.webp';
import governanceOperational from '~/assets/images/services/governance-operational-leadership.webp';
import pmo from '~/assets/images/services/pmo-programme-governance.webp';
import organisationalScaling from '~/assets/images/services/organisational-scaling.webp';
import corporateCompliance from '~/assets/images/services/corporate-compliance-ai-frameworks.webp';

interface Props {
  doc: CollectionEntry<'services'>;
  locale: Locale;
  /** Locale-agnostic path of this page, e.g. `/services/strategic-advisory`. */
  path: string;
}

const { doc, locale, path } = Astro.props;
const t = getDictionary(locale);
const { Content } = await render(doc);

const seo = buildSeo({
  path: localizePath(path, locale),
  locale,
  title: doc.data.title,
  description: doc.data.lede,
});

const contactHref = localizePath('/contact', locale);
const servicesHref = localizePath('/services', locale);

/**
 * Per-service hero background. Each entry pairs the WebP asset (rendered
 * via Astro's <Image>) with the dominant background colour sampled from
 * the source PNG; we fall back to that solid colour on viewports too
 * wide for the image to cover.
 */
const HERO_BG: Record<string, { image: ImageMetadata; color: string }> = {
  'strategic-advisory': { image: strategicAdvisory, color: '#f7f2eb' },
  'governance-operational-leadership': { image: governanceOperational, color: '#f8f0ea' },
  'pmo-programme-governance': { image: pmo, color: '#f6eee8' },
  'organisational-scaling': { image: organisationalScaling, color: '#f9eee5' },
  'corporate-compliance-ai-frameworks': { image: corporateCompliance, color: '#f6ede6' },
};
const hero = HERO_BG[contentSlug(doc.id)];
---
<Base seo={seo}>
  <section class={hero ? 'page-hero page-hero-image' : 'page-hero'} style={hero ? `--hero-bg: ${hero.color};` : undefined}>
    {hero && (
      <Image
        src={hero.image}
        alt=""
        widths={[800, 1200, 1600, 2000]}
        sizes="100vw"
        class="page-hero-bg"
        loading="eager"
        fetchpriority="high"
      />
    )}
    {hero && <div class="page-hero-scrim" aria-hidden="true"></div>}
    <div class="container page-hero-content">
      <p class="eyebrow">
        <a href={servicesHref}>{t.services.eyebrow}</a>
      </p>
      <h1>{doc.data.title}</h1>
      <p class="page-lede">{doc.data.lede}</p>
    </div>
  </section>

  <section class="section">
    <div class="container service-detail-grid">
      <figure class="service-placeholder-art" aria-hidden="true">
        <LogoMark size={120} />
      </figure>

      <article class="prose service-prose">
        <Content />
        <aside class="service-placeholder-note" role="note">
          {t.services.placeholderNote}
        </aside>
      </article>
    </div>
  </section>

  <PlatformCta locale={locale} variant="soft" />

  <section class="section section-dark">
    <div class="container closing">
      <h2>{t.services.closingTitle}</h2>
      <p>{t.services.closingBody}</p>
      <a class="btn btn-light" href={contactHref}>{t.services.closingButton}</a>
    </div>
  </section>
</Base>
