---
import { render } from 'astro:content';
import { Image } from 'astro:assets';
import Base from '~/layouts/Base.astro';
import { buildSeo, articleLd } from '~/lib/seo';
import { toIsoDate } from '~/lib/format';
import { postHref } from '~/lib/content';
import { SITE } from '~/lib/site';
import { formatDate, localizePath, type Locale } from '~/i18n';
import type { CollectionEntry } from 'astro:content';

interface Props {
  post: CollectionEntry<'posts'>;
  locale: Locale;
}
const { post, locale } = Astro.props;
const { Content } = await render(post);

const path = postHref(post, locale);
const seo = buildSeo({
  path,
  locale,
  title: post.data.title,
  description: post.data.description,
  type: 'article',
  publishedAt: toIsoDate(post.data.publishedAt),
  modifiedAt: post.data.updatedAt ? toIsoDate(post.data.updatedAt) : undefined,
  author: post.data.author,
});

const jsonLd = [
  articleLd({
    title: post.data.title,
    description: post.data.description,
    url: seo.canonical,
    publishedAt: toIsoDate(post.data.publishedAt),
    modifiedAt: post.data.updatedAt ? toIsoDate(post.data.updatedAt) : undefined,
    author: post.data.author,
    locale,
  }),
];
---
<Base seo={seo} jsonLd={jsonLd}>
  <article class="single-post">
    <header class="single-hero">
      <div class="container">
        <p class="eyebrow">
          <time datetime={toIsoDate(post.data.publishedAt)}>{formatDate(post.data.publishedAt, locale)}</time>
          {post.data.author && <span> · {post.data.author}</span>}
        </p>
        <h1 class="single-title">{post.data.title}</h1>
        <p class="single-lede">{post.data.description}</p>
      </div>
    </header>

    {post.data.cover && (
      <figure class="single-featured">
        <Image
          src={post.data.cover}
          alt=""
          widths={[640, 1024, 1600]}
          sizes="(max-width: 1180px) 100vw, 1180px"
          loading="eager"
          fetchpriority="high"
        />
      </figure>
    )}

    <div class="container" style="padding: 24px 0 32px;">
      <div class="prose">
        <Content />
      </div>
    </div>

    {post.data.cta && (
      <aside class="container news-cta" aria-label={SITE.name}>
        <p class="news-cta-hook">{post.data.cta.hook}</p>
        <a class="btn btn-primary news-cta-button" href={localizePath('/contact', locale)}>
          {post.data.cta.label}
        </a>
      </aside>
    )}
  </article>
</Base>
