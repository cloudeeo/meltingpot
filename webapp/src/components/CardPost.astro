---
import { Image } from 'astro:assets';
import { toIsoDate, truncate } from '~/lib/format';
import { postHref } from '~/lib/content';
import { formatDate, type Locale } from '~/i18n';
import type { CollectionEntry } from 'astro:content';

interface Props {
  post: CollectionEntry<'posts'>;
  locale: Locale;
}
const { post, locale } = Astro.props;
const href = postHref(post, locale);
---
<article class="card card-post">
  {post.data.cover && (
    <a class="card-media" href={href} aria-label={post.data.title} tabindex="-1">
      <Image src={post.data.cover} alt="" width={800} height={500} loading="lazy" />
    </a>
  )}
  <div class="card-body">
    <p class="card-meta">
      <time datetime={toIsoDate(post.data.publishedAt)}>{formatDate(post.data.publishedAt, locale)}</time>
    </p>
    <h3 class="card-title"><a href={href}>{post.data.title}</a></h3>
    <p class="card-excerpt">{truncate(post.data.description, 160)}</p>
  </div>
</article>
