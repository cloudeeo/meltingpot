---
interface Props {
  title: string;
}
const { title } = Astro.props;
---
<!doctype html>
<html lang="en">
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="robots" content="noindex, nofollow" />
    <title>{title} — Executive Founders admin</title>
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <style is:global>
      :root {
        --color-ink: #0F172A;
        --color-ink-2: #1F2937;
        --color-muted: #475569;
        --color-line: #E5E7EB;
        --color-bg-soft: #F7F7F5;
        --color-accent: #E0394E;
        --color-success: #059669;
        --color-warning: #C89B1A;
      }
      * { box-sizing: border-box; }
      body {
        margin: 0;
        font-family: 'Inter', system-ui, -apple-system, sans-serif;
        font-size: 15px;
        color: var(--color-ink-2);
        background: var(--color-bg-soft);
        line-height: 1.5;
      }
      header.admin-header {
        background: var(--color-ink);
        color: #fff;
        padding: 14px 24px;
        display: flex;
        align-items: center;
        justify-content: space-between;
      }
      header.admin-header a { color: #fff; text-decoration: none; font-weight: 600; }
      header.admin-header nav a { margin-left: 18px; font-weight: 500; font-size: 0.92em; opacity: 0.85; }
      header.admin-header nav a:hover { opacity: 1; }
      main.admin-main { max-width: 1100px; margin: 0 auto; padding: 32px 24px 64px; }
      h1, h2, h3 { color: var(--color-ink); margin-top: 0; }
      h1 { font-size: 1.6rem; margin-bottom: 6px; }
      h2 { font-size: 1.2rem; margin-top: 24px; margin-bottom: 12px; }
      p { margin: 0 0 12px; }
      .admin-card { background: #fff; border: 1px solid var(--color-line); border-radius: 8px; padding: 20px; margin-bottom: 18px; }
      .admin-card-meta { font-size: 0.78em; color: var(--color-muted); text-transform: uppercase; letter-spacing: 0.08em; margin-bottom: 8px; }
      .admin-card-meta span + span::before { content: ' · '; }
      .admin-card-title { font-size: 1.1rem; font-weight: 700; color: var(--color-ink); margin-bottom: 6px; }
      .admin-card-title a { color: inherit; text-decoration: none; }
      .admin-card-title a:hover { color: var(--color-accent); }
      .admin-pill {
        display: inline-block;
        padding: 2px 10px;
        border-radius: 999px;
        font-size: 0.72em;
        font-weight: 700;
        text-transform: uppercase;
        letter-spacing: 0.06em;
      }
      .admin-pill-pending { background: #FEF7E0; color: #6B5300; border: 1px solid #F2D77A; }
      .admin-pill-approved { background: #ECFDF5; color: #047857; border: 1px solid #A7F3D0; }
      .admin-pill-rejected { background: #FEF2F2; color: #B91C1C; border: 1px solid #FECACA; }
      .admin-btn {
        display: inline-block;
        padding: 8px 16px;
        font-size: 0.9rem;
        font-weight: 600;
        border-radius: 6px;
        border: 1px solid var(--color-line);
        background: #fff;
        color: var(--color-ink);
        cursor: pointer;
        text-decoration: none;
      }
      .admin-btn-primary { background: var(--color-ink); color: #fff; border-color: var(--color-ink); }
      .admin-btn-success { background: var(--color-success); color: #fff; border-color: var(--color-success); }
      .admin-btn-danger  { background: #B91C1C; color: #fff; border-color: #B91C1C; }
      .admin-btn:hover { opacity: 0.9; }
      .admin-empty { color: var(--color-muted); font-style: italic; padding: 24px; text-align: center; background: #fff; border: 1px dashed var(--color-line); border-radius: 8px; }
      .admin-form-row { display: flex; flex-direction: column; gap: 4px; margin-bottom: 14px; }
      .admin-form-row label { font-weight: 600; font-size: 0.85rem; color: var(--color-ink); }
      .admin-form-row input, .admin-form-row textarea, .admin-form-row select {
        font: inherit;
        padding: 8px 10px;
        border: 1px solid var(--color-line);
        border-radius: 4px;
        background: #fff;
        color: var(--color-ink);
      }
      .admin-form-row textarea { resize: vertical; min-height: 80px; font-family: ui-monospace, SFMono-Regular, Menlo, monospace; font-size: 0.88em; }
      .admin-form-row .help { font-size: 0.78em; color: var(--color-muted); }
      .admin-image-preview {
        max-width: 320px;
        border: 1px solid var(--color-line);
        border-radius: 6px;
        margin-bottom: 14px;
      }
      .admin-actions { display: flex; gap: 8px; flex-wrap: wrap; align-items: center; }
      .admin-actions form { display: inline; }
      .admin-back { font-size: 0.88rem; color: var(--color-muted); text-decoration: none; }
      .admin-back:hover { color: var(--color-ink); }
      .admin-notes { background: #FEF7E0; border: 1px solid #F2D77A; border-left: 4px solid var(--color-warning); padding: 10px 14px; border-radius: 6px; font-size: 0.88rem; margin-bottom: 14px; white-space: pre-wrap; }
      .admin-flash { padding: 12px 16px; border-radius: 6px; margin-bottom: 16px; }
      .admin-flash-ok { background: #ECFDF5; color: #065F46; border: 1px solid #A7F3D0; }
      .admin-flash-err { background: #FEF2F2; color: #B91C1C; border: 1px solid #FECACA; }
    </style>
  </head>
  <body>
    <header class="admin-header">
      <a href="/admin/drafts">Executive Founders · Admin</a>
      <nav>
        <a href="/admin/drafts">Drafts</a>
        <a href="/">↗ Public site</a>
      </nav>
    </header>
    <main class="admin-main">
      <slot />
    </main>
  </body>
</html>
