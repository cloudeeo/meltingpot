---
import '~/styles/global.css';
import Header from '~/components/Header.astro';
import Footer from '~/components/Footer.astro';
import CookieBanner from '~/components/CookieBanner.astro';
import SeoHead from '~/components/SeoHead.astro';
import type { Seo } from '~/lib/seo';
import { SITE } from '~/lib/site';
import {
  getLocaleFromUrl,
  getAlternates,
  getDictionary,
  localizePath,
  localeHtmlLang,
  defaultLocale,
} from '~/i18n';

interface Props {
  seo: Seo;
  jsonLd?: Record<string, unknown>[];
  bodyClass?: string;
}
const { seo, jsonLd, bodyClass = '' } = Astro.props;

const locale = getLocaleFromUrl(Astro.url);
const t = getDictionary(locale);
const alternates = getAlternates(Astro.url.pathname);
const defaultAlt = alternates.find((a) => a.locale === defaultLocale) ?? alternates[0];
---
<!doctype html>
<html lang={localeHtmlLang[locale]}>
  <head>
    <meta charset="UTF-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1" />
    <meta name="theme-color" content="#0F172A" />
    <link rel="icon" type="image/svg+xml" href="/favicon.svg" />
    <link rel="preconnect" href="https://fonts.googleapis.com" crossorigin />
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin />
    <link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap" media="print" onload="this.media='all'" />
    <noscript><link rel="stylesheet" href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700;800;900&display=swap" /></noscript>
    <link rel="sitemap" href="/sitemap-index.xml" />
    <link rel="alternate" type="application/rss+xml" title={`${SITE.name} — ${t.news.rssTitle}`} href={localizePath('/rss.xml', locale)} />
    {alternates.map((alt) => (
      <link rel="alternate" hreflang={localeHtmlLang[alt.locale]} href={`${SITE.url}${alt.path}`} />
    ))}
    <link rel="alternate" hreflang="x-default" href={`${SITE.url}${defaultAlt.path}`} />
    <SeoHead seo={seo} jsonLd={jsonLd} locale={locale} />
    <slot name="head" />
  </head>
  <body class={bodyClass}>
    <Header locale={locale} />
    <main id="site-main" class="site-main">
      <slot />
    </main>
    <Footer locale={locale} />
    <CookieBanner locale={locale} />
  </body>
</html>
